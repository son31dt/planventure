# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///planventure.db
# For PostgreSQL: postgresql://user:password@localhost:5432/planventure
# For MySQL: mysql+pymysql://user:password@localhost:3306/planventure

# CORS Configuration - comma-separated list of allowed origins
# Development (React dev server on port 3000 or Vite on 5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Production (adjust to your actual frontend domain)
# CORS_ORIGINS=https://planventure.com,https://www.planventure.com

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
